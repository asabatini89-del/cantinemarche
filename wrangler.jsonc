{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cantine-delle-marche",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "r2_buckets": [
    // Immagini delle cantine: npx wrangler r2 bucket create cantine-media
    { "binding": "MEDIA", "bucket_name": "cantine-media" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cantine-marche",
      // Sostituire con l'id restituito da: npx wrangler d1 create cantine-marche
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ]
}
