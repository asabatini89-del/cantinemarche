---
import BaseLayout from '../layouts/BaseLayout.astro';
import MappaViva from '../components/MappaViva.astro';
import Mascotte from '../components/Mascotte.astro';
import TerritoryCover from '../components/TerritoryCover.astro';
import { featuredExperiences, getFacets, getStats, listDenominations, listTerritories, mapCards, mapPoints } from '../lib/db';
import { shortName } from '../lib/palette';

const [stats, points, facets, territories, denominations, experiences, cards] = await Promise.all([
  getStats(),
  mapPoints(),
  getFacets(),
  listTerritories(),
  listDenominations(),
  featuredExperiences(6),
  mapCards(),
]);
const KIND_LABEL = { tasting: 'Degustazione', tour: 'Visita', meal: 'A tavola', event: 'Evento', stay: 'Ospitalità' } as const;
const KIND_BG = { tasting: 'bg-giallo', tour: 'bg-azzurro', meal: 'bg-albicocca', event: 'bg-rosa', stay: 'bg-menta' } as const;
const fmtPrice = (c: number) => `${(c / 100).toLocaleString('it-IT', { maximumFractionDigits: 2 })} €`;
const fmtDuration = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h${m % 60 ? ` ${m % 60}′` : ''}` : `${m}′`);
const docg = denominations.filter((d) => d.level === 'DOCG');
const fmt = (n: number) => n.toLocaleString('it-IT');
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---
<BaseLayout title="Cantine delle Marche" canonical="/" overlayHeader>
  <!-- La mappa viva: le Marche vere, a tutto schermo -->
  <MappaViva cards={cards} points={points} provinces={facets.provincia} total={stats.wineries} />

  <!-- I territori come copertine di una collana -->
  <section id="dopo-la-mappa" aria-labelledby="h-territori" class="mx-auto mt-20 max-w-6xl scroll-mt-24 px-4 sm:px-6">
    <div class="copertina-titolo flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-3">
      <h2 id="h-territori" class="display text-4xl sm:text-6xl">Sette territori &amp; <em>sette letture</em></h2>
      <a href="/territori" class="pillola hover:bg-giallo">Tutta la collana →</a>
    </div>
    <ul role="list" class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {territories.map((t, i) => <li data-reveal style={`--i:${i % 4}`}><TerritoryCover territory={t} index={i} /></li>)}
      <li class="hidden lg:block" data-reveal style="--i:3">
        <a href="/cantine" class="group flex aspect-[2/3] flex-col justify-between rounded-sm border-2 border-inchiostro bg-carta p-4 transition-transform hover:-translate-y-1 hover:shadow-[6px_6px_0_var(--color-inchiostro)]">
          <span class="meta">Fuori collana</span>
          <span class="display text-[2.1rem]">Tutte le {fmt(stats.wineries)} cantine, <em class="text-rosso">dalla A alla Z.</em></span>
          <span class="pillola self-start group-hover:bg-giallo">Il catalogo →</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- Le esperienze: degustazioni e visite in cantina -->
  {experiences.length > 0 && (
    <section aria-labelledby="h-esperienze" class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
      <div class="copertina-titolo flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 py-3">
        <h2 id="h-esperienze" class="display text-4xl sm:text-6xl">Da assaggiare <em>in cantina</em></h2>
        <a href="/cantine?servizio=degustazioni" class="pillola hover:bg-giallo">{stats.experience_wineries} cantine con esperienze →</a>
      </div>
      <p class="mano mt-4 -rotate-1 text-2xl sm:text-3xl">Domani degustazione? Eccone qualcuna.</p>
      <ul role="list" class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {experiences.map((e, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <a href={`/cantine/${e.winery_slug}#esperienze`} class="group flex h-full flex-col rounded-2xl border-2 border-inchiostro bg-carta shadow-[5px_5px_0_var(--color-inchiostro)] transition-transform hover:-translate-y-1">
              <span class={`flex items-center justify-between gap-3 rounded-t-[14px] border-b-2 border-inchiostro px-4 py-2 ${KIND_BG[e.kind]}`}>
                <span class="meta">{KIND_LABEL[e.kind]}</span>
                <span class="meta">{[e.duration_min !== null ? fmtDuration(e.duration_min) : null, e.price_cents !== null ? fmtPrice(e.price_cents) : null].filter(Boolean).join(' · ')}</span>
              </span>
              <span class="flex flex-1 flex-col p-4">
                <span class="display text-2xl group-hover:underline">{e.title}</span>
                {e.description_md && <span class="mt-2 line-clamp-3 text-sm">{e.description_md}</span>}
                <span class="meta mt-auto pt-4 text-grafite">{shortName(e.winery_name)} · {e.municipality}{e.province_code ? ` (${e.province_code})` : ''}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Le DOCG -->
  <section aria-labelledby="h-docg" class="mx-auto mt-20 grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[1fr_2fr]">
    <div>
      <h2 id="h-docg" class="display text-4xl sm:text-6xl">Le DOCG, <em class="text-rosso">per cominciare.</em></h2>
      <p class="mt-4 max-w-sm">{docg.length === 5 ? 'Cinque' : docg.length} denominazioni di origine controllata e garantita. Poi ci sono le DOC, e la libertà dell'IGT.</p>
      <a href="/denominazioni" class="btn mt-6">Tutte le {denominations.length} denominazioni</a>
    </div>
    <ol class="border-t-2 border-inchiostro">
      {docg.map((d, i) => (
        <li class="border-b-2 border-inchiostro" data-reveal style={`--i:${i}`}>
          <a href={`/denominazioni/${d.slug}`} class="group flex items-baseline gap-4 px-2 py-4 transition-colors hover:bg-giallo">
            <span class="display w-10 shrink-0 text-2xl text-rosso">{['I', 'II', 'III', 'IV', 'V', 'VI', 'VII'][i]}</span>
            <span class="display text-2xl sm:text-[2.1rem]">{d.name.replace(/ DOCG$/, '')}</span>
            <span class="meta ml-auto shrink-0">{d.winery_count > 0 ? `${d.winery_count} cantine` : 'da censire'}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <!-- Per i produttori -->
  <section aria-labelledby="h-cantine" class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
    <div data-reveal class="grid items-center gap-6 rounded-sm border-2 border-inchiostro bg-giallo p-6 shadow-[8px_8px_0_var(--color-inchiostro)] sm:p-10 md:grid-cols-[2fr_1fr]">
      <div>
        <p class="meta">Per i produttori</p>
        <h2 id="h-cantine" class="display mt-3 text-4xl sm:text-6xl">Sei una cantina? <em class="text-rosso">La scheda è tua.</em></h2>
        <p class="mt-4 max-w-lg">Correggi i dati, aggiungi orari, foto ed esperienze. Gratis, in pochi minuti, senza agenzie di mezzo.</p>
        <a href="/per-le-cantine" class="btn-primary mt-6">Rivendica la scheda</a>
      </div>
      <Mascotte nota="La scheda è mia?" class="mx-auto w-40 sm:w-48" />
    </div>
  </section>
</BaseLayout>
