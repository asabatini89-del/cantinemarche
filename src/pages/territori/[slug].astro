---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarcheMap from '../../components/MarcheMap.astro';
import WineryCard from '../../components/WineryCard.astro';
import { getTerritory, listWineries, mapPoints } from '../../lib/db';
import { parseFilters } from '../../lib/filters';
import { coverFor } from '../../lib/palette';

const t = await getTerritory(Astro.params.slug ?? '');
if (!t) return new Response(null, { status: 404 });

const dens = (t.denominations ?? '').split('|').filter(Boolean).map((d) => {
  const [id, ...name] = d.split(':');
  return { id, name: name.join(':') };
});
const filters = { ...parseFilters(new URL('http://x/')), denominazione: dens.map((d) => d.id) };
const [{ items, total }, points] = dens.length
  ? await Promise.all([listWineries(filters, 500), mapPoints(filters)])
  : [{ items: [], total: 0 }, []];
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---
<BaseLayout title={t.name} description={`${t.name}: ${t.intro ?? ''} ${total} cantine nel catalogo.`} canonical={`/territori/${t.slug}`}>
  <header class={coverFor(t.id)}>
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <nav aria-label="Percorso" class="meta"><a href="/territori" class="hover:underline">I territori</a> /</nav>
      <h1 class="display mt-6 text-6xl sm:text-8xl">{t.name}</h1>
      <p class="mt-6 max-w-2xl font-serif text-2xl leading-snug sm:text-3xl"><em>{t.intro}</em></p>
    </div>
  </header>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 pt-10 sm:px-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
    <div>
      <h2 class="meta text-grafite">Denominazioni del territorio</h2>
      <ul role="list" class="mt-3 border-t border-inchiostro">
        {dens.map((d) => (
          <li class="border-b border-inchiostro">
            <a href={`/denominazioni/${d.id}`} class="group flex items-baseline justify-between gap-4 py-3 hover:bg-carta-2">
              <span class="display text-2xl group-hover:text-rosso">{d.name}</span><span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-grafite">{total} cantine dichiarano almeno una di queste denominazioni. {points.length < total && `${total - points.length} non hanno ancora una posizione sulla mappa.`}</p>
      <a href={`/cantine?${dens.map((d) => `denominazione=${d.id}`).join('&')}`} class="btn mt-6">Filtra nel catalogo</a>
    </div>
    {points.length > 0 && (
      <MarcheMap points={points} frame="points" label={`Mappa delle cantine di ${t.name}`} />
    )}
  </div>

  <section aria-labelledby="h-cantine" class="mx-auto mt-16 max-w-6xl px-4 sm:px-6">
    <h2 id="h-cantine" class="display border-b border-inchiostro pb-3 text-4xl">Le cantine, <em>{total}</em></h2>
    <ul role="list" class="mt-6 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((w) => <li><WineryCard winery={w} /></li>)}
    </ul>
  </section>
</BaseLayout>
