---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PosterHeader from '../../components/PosterHeader.astro';
import TerritoryCover from '../../components/TerritoryCover.astro';
import { listTerritories } from '../../lib/db';

const territories = await listTerritories();
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');
---
<BaseLayout title="I territori" description="Sette territori del vino marchigiano: Castelli di Jesi, Conero, Matelica, Piceno, Metauro, Morro d’Alba, colline maceratesi." canonical="/territori">
  <PosterHeader kicker={`Collana · ${territories.length} volumi`} word="I territori" size="lg"
    subtitle="Ogni territorio è una piccola monografia: un paesaggio, un vino che lo racconta, le persone che lo fanno."
    note="da leggere in ordine sparso" />

  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <ol class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {territories.map((t, i) => (
        <li>
          <TerritoryCover territory={t} index={i} size="lg" />
          <p class="mt-4">{t.intro}</p>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
