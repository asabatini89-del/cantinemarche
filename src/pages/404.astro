---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Pagina non trovata" noindex>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="meta text-muted">Errore 404</p>
    <h1 class="mt-2 font-serif text-5xl font-medium">Questa pagina non c'è.</h1>
    <p class="mt-3 text-muted">Forse la cantina ha cambiato indirizzo. Riparti dal catalogo.</p>
    <a href="/cantine" class="mt-8 inline-flex h-11 items-center rounded-md bg-wine px-5 text-sm font-semibold text-primary hover:bg-wine-dark">Tutte le cantine</a>
  </div>
</BaseLayout>
