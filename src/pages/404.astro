---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascotte from '../components/Mascotte.astro';
---
<BaseLayout title="Pagina non trovata" noindex>
  <section class="grana border-b-2 border-inchiostro bg-pesca">
    <div class="mx-auto grid max-w-6xl items-end gap-8 px-4 py-14 sm:px-6 md:grid-cols-[minmax(0,3fr)_minmax(0,1fr)]">
      <div>
        <p class="meta">Errore 404 · pagina mancante</p>
        <h1 class="manifesto mt-3 text-[clamp(4.5rem,20vw,12rem)]">Ops</h1>
        <p class="display mt-4 text-3xl italic sm:text-4xl">Questa pagina non è in catalogo.</p>
        <p class="mt-4 max-w-md text-lg">Forse la cantina ha cambiato nome, o il link è vecchio. Riparti dall’indice.</p>
        <div class="mt-8 flex flex-wrap gap-2"><a href="/cantine" class="btn-primary">Tutte le cantine</a><a href="/" class="btn bg-carta">La mappa</a></div>
      </div>
      <Mascotte nota="Ci siamo persi?" class="mx-auto w-36 sm:w-44" />
    </div>
  </section>
</BaseLayout>
