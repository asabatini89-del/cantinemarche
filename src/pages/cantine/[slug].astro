---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarcheMap from '../../components/MarcheMap.astro';
import WineryCard from '../../components/WineryCard.astro';
import FormNotice from '../../components/FormNotice.astro';
import { getWinery, nearbyWineries } from '../../lib/db';
import { catalogNo, displayName } from '../../lib/palette';

const data = await getWinery(Astro.params.slug ?? '');
if (!data) return new Response(null, { status: 404, statusText: 'Not found' });

const { winery: w, denominations, grapes, services, wines, sources, photos, experiences } = data;
const title = displayName(w.name);
const nearby = await nearbyWineries(w);
const sent = Astro.url.searchParams.has('inviata');
const error = Astro.url.searchParams.get('errore');
// Le pagine con esito del form non vanno in cache condivisa.
Astro.response.headers.set('Cache-Control', sent || error ? 'private, no-store' : 'public, max-age=300, s-maxage=3600, stale-while-revalidate=86400');

const place = [w.municipality, w.province_code ? `(${w.province_code})` : null].filter(Boolean).join(' ');
const telHref = w.phone ? `tel:${w.phone.split(/[\/,;]| - /)[0].replace(/[^\d+]/g, '')}` : null;
const hasCoords = w.lat !== null && w.lng !== null;
const mapsHref = hasCoords
  ? `https://www.google.com/maps/search/?api=1&query=${w.lat},${w.lng}`
  : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent([w.name, w.address_line, place].filter(Boolean).join(', '))}`;
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };
// Accanto a un vino si indica la fonte solo quando non è il sito della cantina (enoteca, guida, consorzio).
const ownHost = w.website ? host(w.website) : null;
const via = (u: string | null) => (u && host(u) !== ownHost ? host(u) : null);
const fmtDate = (d: string | null) => (d ? new Date(d).toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }) : null);
const today = new Date().toISOString().slice(0, 10);
const VISIBLE_WINES = 12;
const KIND_LABEL = { tasting: 'Degustazione', tour: 'Visita', meal: 'A tavola', event: 'Evento', stay: 'Ospitalità' } as const;
const KIND_BG = { tasting: 'bg-giallo', tour: 'bg-azzurro', meal: 'bg-albicocca', event: 'bg-rosa', stay: 'bg-menta' } as const;
const fmtDuration = (m: number) => (m >= 60 ? `${Math.floor(m / 60)} h${m % 60 ? ` ${m % 60} min` : ''}` : `${m} min`);
const fmtPrice = (c: number) => `${(c / 100).toLocaleString('it-IT', { maximumFractionDigits: 2 })} €`;
const chosenExperience = Astro.url.searchParams.get('esperienza');
const hasBottles = wines.some((v) => v.bottle_key);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Winery',
  name: w.name,
  url: new URL(`/cantine/${w.slug}`, Astro.site).href,
  ...(w.website && { sameAs: [w.website] }),
  ...(w.phone && { telephone: w.phone }),
  ...(w.email && { email: w.email }),
  address: {
    '@type': 'PostalAddress',
    ...(w.address_line && { streetAddress: w.address_line }),
    ...(w.municipality && { addressLocality: w.municipality }),
    ...(w.postal_code && { postalCode: w.postal_code }),
    ...(w.province_code && { addressRegion: w.province_code }),
    addressCountry: 'IT',
  },
  ...(hasCoords && { geo: { '@type': 'GeoCoordinates', latitude: w.lat, longitude: w.lng } }),
};
const field = 'mt-1.5 h-11 w-full rounded-lg border-[1.5px] border-inchiostro bg-carta px-3 text-[15px] focus:border-rosso focus:outline-none';
---
<BaseLayout
  title={title}
  description={`${w.name}${place ? `, ${place}` : ''}: contatti, denominazioni e vini. Dal catalogo ragionato delle cantine delle Marche.`}
  canonical={`/cantine/${w.slug}`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="grana border-b-2 border-inchiostro bg-pesca">
      <div class="mx-auto max-w-6xl px-4 pb-10 pt-8 sm:px-6">
      <nav aria-label="Percorso" class="meta"><a href="/cantine" class="hover:underline">Le cantine</a> / <span class="text-rosso">{catalogNo(w.num)}</span></nav>
      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-end">
        <div>
          <p class="meta">{[w.province_name, w.territory_name].filter(Boolean).join(' · ')}</p>
          <h1 class="display copertina-titolo mt-3 py-3 text-[3rem] sm:text-[5.2rem]">{title}</h1>
          {(w.address_line || place) && <p class="mt-5 max-w-xl text-lg">{w.address_line ?? place}</p>}
          {wines.length > 0 && <p class="mano mt-3 -rotate-1 text-2xl sm:text-3xl">{wines.length === 1 ? 'un’etichetta' : `${wines.length} etichette`}, da assaggiare</p>}
          <div class="mt-7 flex flex-wrap gap-2">
            <a href={mapsHref} target="_blank" rel="noopener" class="btn-primary">Indicazioni</a>
            {telHref && <a href={telHref} class="btn bg-carta">Chiama</a>}
            {w.email && <a href={`mailto:${w.email}`} class="btn bg-carta">Scrivi</a>}
            {w.website && <a href={w.website} target="_blank" rel="noopener" class="btn bg-carta">Sito <span aria-hidden="true">↗</span></a>}
            {experiences.length > 0 && <a href="#esperienze" class="btn bg-carta">Esperienze</a>}
            <a href="#visita" class="btn bg-carta">Richiedi una visita</a>
          </div>
        </div>
        {hasCoords && (
          <div class="w-full max-w-sm lg:justify-self-end">
            <MarcheMap points={[{ slug: w.slug, name: w.name, municipality: w.municipality, province_code: w.province_code, lat: w.lat!, lng: w.lng! }]}
              highlight={w.province_code} interactive={false} locator label={`Posizione di ${w.name} nelle Marche`} />
            <p class="meta mt-1 text-grafite">{w.coordinate_status === 'approximate' ? 'Posizione approssimativa' : 'Posizione © OpenStreetMap'}</p>
          </div>
        )}
      </div>
      </div>
    </header>

    {photos.length > 0 && (
      <figure class="mx-auto mt-8 max-w-6xl px-4 sm:px-6">
        <div class={`grid gap-2 ${photos.length > 1 ? 'sm:grid-cols-[2fr_1fr]' : ''}`}>
          <img src={`/media/${photos[0].r2_key}`} srcset={`/media/${photos[0].thumb_key ?? photos[0].r2_key} 640w, /media/${photos[0].r2_key} 1600w`}
            sizes="(min-width: 1152px) 760px, 100vw" alt={`${title}: foto dal sito della cantina`}
            width={photos[0].width ?? 1600} height={photos[0].height ?? 1067} fetchpriority="high"
            class="aspect-[3/2] h-full w-full rounded-sm border-2 border-inchiostro bg-carta-2 object-cover" />
          {photos.length > 1 && (
            <div class="grid grid-cols-3 gap-2 sm:grid-cols-1">
              {photos.slice(1, 4).map((p) => (
                <img src={`/media/${p.thumb_key ?? p.r2_key}`} alt="" width="640" height="427" loading="lazy" decoding="async"
                  class="aspect-[3/2] h-full w-full rounded-sm border-2 border-inchiostro bg-carta-2 object-cover" />
              ))}
            </div>
          )}
        </div>
        <figcaption class="meta mt-2 flex flex-wrap justify-between gap-x-6 gap-y-1 text-grafite">
          <span>Foto: {photos[0].source_page ? <a href={photos[0].source_page} target="_blank" rel="noopener nofollow" class="underline decoration-inchiostro/30 hover:text-inchiostro">{host(photos[0].source_page)}</a> : 'sito della cantina'}</span>
          <a href={`/per-le-cantine?cantina=${w.slug}&motivo=correzione#modulo`} class="hover:text-inchiostro hover:underline">Sei la cantina? Chiedi una modifica o la rimozione</a>
        </figcaption>
      </figure>
    )}

    {w.data_note && (
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <p class="mt-6 border-l-4 border-rosso pl-4 text-sm"><span class="meta mr-2 text-rosso">Nota</span>{w.data_note}</p>
      </div>
    )}

    <div class="mx-auto mt-12 grid max-w-6xl gap-14 px-4 sm:px-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="space-y-14">
        {(denominations.length > 0 || grapes.length > 0) && (
          <section aria-labelledby="h-denominazioni">
            <h2 id="h-denominazioni" class="display text-4xl sm:text-5xl">{denominations.length > 0 ? <>Denominazioni <em>e vitigni</em></> : 'Vitigni'}</h2>
            {denominations.length > 0 && <ul role="list" class="mt-5 border-t-2 border-inchiostro">
              {denominations.map((d) => (
                <li class="border-b-2 border-inchiostro">
                  <a href={`/denominazioni/${d.id}`} class="group flex items-baseline justify-between gap-4 px-1 py-3 transition-colors hover:bg-giallo">
                    <span class="font-serif text-2xl">{d.name.replace(/ (DOCG|DOC|IGT)$/, '')}</span>
                    <span class="meta text-grafite">{d.level}</span>
                  </a>
                </li>
              ))}
            </ul>}
            {grapes.length > 0 && (
              <p class="meta mt-4 text-grafite">Vitigni: {grapes.map((g, i) => <>{i > 0 && ' / '}<a href={`/cantine?vitigno=${g.id}`} class="text-inchiostro hover:underline">{g.name}</a></>)}</p>
            )}
          </section>
        )}

        <section aria-labelledby="h-vini">
          <h2 id="h-vini" class="display copertina-titolo flex items-baseline justify-between gap-4 py-3 text-4xl sm:text-5xl">I vini {wines.length > 0 && <span class="manifesto text-5xl sm:text-6xl">{wines.length}</span>}</h2>
          {wines.length > 0 ? (
            <>
              <p class="mt-2 text-grafite">{wines.length} {wines.length === 1 ? 'etichetta rilevata' : 'etichette rilevate'} da fonti pubbliche: ogni voce rimanda alla sua fonte. Per prezzi e disponibilità fa fede la cantina.</p>
              <ol class="mt-5 sm:columns-2 sm:gap-8">
                {wines.slice(0, VISIBLE_WINES).map((v, i) => (
                  <li class="break-inside-avoid border-b border-inchiostro/25">
                    <a href={v.external_url ?? undefined} target="_blank" rel="noopener" class="group flex items-baseline gap-3 py-2.5">
                      <span class="meta w-6 shrink-0 text-grafite">{String(i + 1).padStart(2, '0')}</span>
                      {hasBottles && (v.bottle_key ? <img src={`/media/${v.bottle_key}`} alt="" width="16" height="48" loading="lazy" class="h-12 w-4 shrink-0 self-center object-contain" /> : <span class="w-4 shrink-0" aria-hidden="true"></span>)}
                      <span class="group-hover:underline">{v.name}</span>
                      <span class="ml-auto flex shrink-0 items-baseline gap-2 text-grafite">{via(v.external_url) && <span class="meta hidden lg:inline">{via(v.external_url)}</span>}<span aria-hidden="true">↗</span></span>
                    </a>
                  </li>
                ))}
              </ol>
              {wines.length > VISIBLE_WINES && (
                <details class="group mt-2">
                  <summary class="btn mt-3 cursor-pointer list-none group-open:hidden [&::-webkit-details-marker]:hidden">Mostra tutte le {wines.length} etichette</summary>
                  <ol start={VISIBLE_WINES + 1} class="sm:columns-2 sm:gap-8">
                    {wines.slice(VISIBLE_WINES).map((v, i) => (
                      <li class="break-inside-avoid border-b border-inchiostro/25">
                        <a href={v.external_url ?? undefined} target="_blank" rel="noopener" class="group flex items-baseline gap-3 py-2.5">
                          <span class="meta w-6 shrink-0 text-grafite">{String(i + VISIBLE_WINES + 1).padStart(2, '0')}</span>
                          {hasBottles && (v.bottle_key ? <img src={`/media/${v.bottle_key}`} alt="" width="16" height="48" loading="lazy" class="h-12 w-4 shrink-0 self-center object-contain" /> : <span class="w-4 shrink-0" aria-hidden="true"></span>)}
                          <span class="group-hover:underline">{v.name}</span>
                          <span class="ml-auto flex shrink-0 items-baseline gap-2 text-grafite">{via(v.external_url) && <span class="meta hidden lg:inline">{via(v.external_url)}</span>}<span aria-hidden="true">↗</span></span>
                        </a>
                      </li>
                    ))}
                  </ol>
                </details>
              )}
            </>
          ) : (
            <p class="mt-4 max-w-lg text-grafite">Le etichette non sono ancora in catalogo. Nel frattempo, chiedile alla cantina: è il modo migliore per cominciare.</p>
          )}
        </section>

        {experiences.length > 0 && (
          <section id="esperienze" aria-labelledby="h-esperienze" class="scroll-mt-6">
            <h2 id="h-esperienze" class="display copertina-titolo flex items-baseline justify-between gap-4 py-3 text-4xl sm:text-5xl"><span>Le <em>esperienze</em></span> <span class="manifesto text-5xl sm:text-6xl">{experiences.length}</span></h2>
            <p class="mt-2 max-w-lg text-grafite">Quello che la cantina propone a chi passa di qui, come lo descrive la fonte. Orari e disponibilità vanno sempre confermati.</p>
            <ul role="list" class="mt-6 grid gap-4 sm:grid-cols-2">
              {experiences.map((e) => (
                <li class="flex flex-col rounded-2xl border-2 border-inchiostro bg-carta shadow-[5px_5px_0_var(--color-inchiostro)]">
                  <div class={`flex items-center justify-between gap-3 rounded-t-[14px] border-b-2 border-inchiostro px-4 py-2 ${KIND_BG[e.kind]}`}>
                    <span class="meta">{KIND_LABEL[e.kind]}</span>
                    {e.price_cents !== null && <span class="meta">{fmtPrice(e.price_cents)} a persona</span>}
                  </div>
                  <div class="flex flex-1 flex-col p-4">
                    <h3 class="display text-2xl">{e.title}</h3>
                    {e.description_md && <p class="mt-2 text-sm">{e.description_md}</p>}
                    <p class="meta mt-3 flex flex-wrap gap-x-3 gap-y-1 text-grafite">
                      {e.duration_min !== null && <span>{fmtDuration(e.duration_min)}</span>}
                      {e.price_cents === null && <span>Prezzo su richiesta</span>}
                    </p>
                    <div class="mt-auto flex flex-wrap items-center gap-2 pt-4">
                      <a href={`/cantine/${w.slug}?esperienza=${encodeURIComponent(e.id)}#visita`} class="btn-primary h-9 px-4">Richiedi</a>
                      {e.external_url && <a href={e.external_url} target="_blank" rel="noopener nofollow" class="meta text-grafite underline decoration-inchiostro/30 hover:text-inchiostro">Fonte: {host(e.external_url)} ↗</a>}
                    </div>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section id="visita" aria-labelledby="h-visita" class="scroll-mt-6">
          <h2 id="h-visita" class="display copertina-titolo py-3 text-4xl sm:text-5xl">Richiedi <em>una visita</em></h2>
          <p class="mt-2 max-w-lg text-grafite">La richiesta arriva alla redazione, che la inoltra alla cantina. Non è una prenotazione: ti risponderanno per confermare giorno e orario.</p>
          <FormNotice sent={sent} error={error} sentText="Richiesta ricevuta. Ti scriveremo all’indirizzo che hai indicato." />
          {!sent && (
            <form method="post" action="/api/richiesta-visita" class="mt-6 grid gap-4 sm:grid-cols-2">
              <input type="hidden" name="cantina" value={w.slug} />
              {experiences.length > 0 && (
                <label class="block text-sm font-medium sm:col-span-2">Esperienza <span class="font-normal text-grafite">(facoltativa)</span>
                  <select name="esperienza" class={field}>
                    <option value="">Una visita, senza un programma preciso</option>
                    {experiences.map((e) => <option value={e.id} selected={e.id === chosenExperience}>{e.title}{e.price_cents !== null ? ` · ${fmtPrice(e.price_cents)}` : ''}</option>)}
                  </select>
                </label>
              )}
              <label class="block text-sm font-medium">Nome e cognome<input name="nome" required autocomplete="name" maxlength="200" class={field} /></label>
              <label class="block text-sm font-medium">Email<input name="email" type="email" required autocomplete="email" maxlength="200" class={field} /></label>
              <label class="block text-sm font-medium">Data desiderata <span class="font-normal text-grafite">(facoltativa)</span><input name="data" type="date" min={today} class={field} /></label>
              <label class="block text-sm font-medium">Persone<input name="persone" type="number" min="1" max="50" value="2" inputmode="numeric" class={field} /></label>
              <label class="block text-sm font-medium sm:col-span-2">Telefono <span class="font-normal text-grafite">(facoltativo)</span><input name="telefono" type="tel" autocomplete="tel" maxlength="40" class={field} /></label>
              <label class="block text-sm font-medium sm:col-span-2">Messaggio<textarea name="messaggio" rows="4" maxlength="2000" placeholder="Degustazione, visita in vigna, acquisto…" class={`${field} h-auto py-2`}></textarea></label>
              <label class="hidden" aria-hidden="true">Non compilare<input name="sito_web" tabindex="-1" autocomplete="off" /></label>
              <label class="flex items-start gap-3 text-sm sm:col-span-2">
                <input type="checkbox" name="consenso" value="si" required class="mt-1 size-4 accent-rosso" />
                <span>Acconsento al trattamento dei miei dati per ricevere risposta, come descritto nell’<a href="/privacy" class="underline">informativa</a>.</span>
              </label>
              <div class="sm:col-span-2"><button type="submit" class="btn-primary">Invia la richiesta</button></div>
            </form>
          )}
        </section>
      </div>

      <aside class="space-y-10 lg:border-l-2 lg:border-inchiostro lg:pl-8">
        <section aria-labelledby="h-contatti">
          <h2 id="h-contatti" class="meta text-grafite">Contatti</h2>
          <dl class="mt-3 space-y-3">
            {w.phone && <div><dt class="meta text-grafite">Telefono</dt><dd><a href={telHref!} class="hover:underline">{w.phone}</a></dd></div>}
            {w.email && <div><dt class="meta text-grafite">Email</dt><dd class="break-all"><a href={`mailto:${w.email}`} class="hover:underline">{w.email}</a></dd></div>}
            {w.website && <div><dt class="meta text-grafite">Sito</dt><dd class="break-all"><a href={w.website} target="_blank" rel="noopener" class="hover:underline">{host(w.website)}</a></dd></div>}
            {!w.phone && !w.email && !w.website && <p class="text-grafite">Nessun contatto pubblico. Sei della cantina? Aggiungili tu.</p>}
          </dl>
        </section>

        {services.length > 0 && (
          <section aria-labelledby="h-servizi">
            <h2 id="h-servizi" class="meta text-grafite">In cantina</h2>
            <ul role="list" class="mt-3 space-y-1 font-serif text-2xl">{services.map((s) => <li>{s.name}</li>)}</ul>
          </section>
        )}

        {sources.length > 0 && (
          <section aria-labelledby="h-fonti">
            <h2 id="h-fonti" class="meta text-grafite">Fonti</h2>
            <ol class="mt-3 space-y-1 text-sm">
              {sources.map((s, i) => <li><sup class="mr-1 text-grafite">{i + 1}</sup><a href={s} target="_blank" rel="noopener nofollow" class="text-grafite underline decoration-inchiostro/30 hover:text-inchiostro">{host(s)}</a></li>)}
            </ol>
            {w.checked_at && <p class="meta mt-3 text-grafite">Verificate il {fmtDate(w.checked_at)}</p>}
          </section>
        )}

        <section aria-labelledby="h-titolare" class="rounded-2xl border-2 border-inchiostro bg-giallo p-5 shadow-[6px_6px_0_var(--color-inchiostro)]">
          <p class="mano -rotate-2 text-2xl">psst…</p>
          <h2 id="h-titolare" class="display mt-1 text-3xl">Sei il titolare?</h2>
          <p class="mt-2 text-sm">Rivendica la scheda per correggere i dati e aggiungere orari, foto ed esperienze.</p>
          <a href={`/per-le-cantine?cantina=${w.slug}#modulo`} class="btn-primary mt-4 h-10">Rivendica la scheda</a>
        </section>
      </aside>
    </div>

    {nearby.length > 0 && (
      <section aria-labelledby="h-vicine" class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
        <h2 id="h-vicine" class="display copertina-titolo py-3 text-4xl sm:text-5xl">Nei <em>paraggi</em></h2>
        <ul role="list" class="mt-6 grid grid-cols-1 gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
          {nearby.map((n) => <li><WineryCard winery={n} /></li>)}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
