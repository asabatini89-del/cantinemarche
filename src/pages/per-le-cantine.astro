---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormNotice from '../components/FormNotice.astro';
import Mascotte from '../components/Mascotte.astro';
import PosterHeader from '../components/PosterHeader.astro';
import { getStats, wineryOptions } from '../lib/db';
import { displayName } from '../lib/palette';

const [stats, wineries] = await Promise.all([getStats(), wineryOptions()]);
const preselected = Astro.url.searchParams.get('cantina') ?? '';
const motivo = Astro.url.searchParams.get('motivo') ?? 'claim';
const sent = Astro.url.searchParams.has('inviata');
const error = Astro.url.searchParams.get('errore');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const field = 'mt-1.5 h-11 w-full rounded-lg border-[1.5px] border-inchiostro bg-carta px-3 text-[15px] focus:border-rosso focus:outline-none';
const steps = [
  { t: 'Ci scrivi', d: 'Con il modulo qui sotto: chi sei e quale cantina rappresenti.' },
  { t: 'Verifichiamo', d: 'Una telefonata o un’email all’indirizzo pubblico della cantina. Di solito entro due giorni lavorativi.' },
  { t: 'La scheda è tua', d: 'Correggi i dati, aggiungi orari, foto, esperienze e le etichette che vuoi raccontare.' },
];
---
<BaseLayout title="Per le cantine" description="Rivendica gratuitamente la scheda della tua cantina sul catalogo delle cantine delle Marche." canonical="/per-le-cantine">
  <PosterHeader kicker="Per i produttori" word="Per le cantine" size="lg" bg="bg-giallo"
    subtitle="La scheda della tua cantina c’è già. Adesso scrivila tu.">
    <p class="mt-5 max-w-xl text-lg leading-snug">
      Abbiamo raccolto {stats.wineries.toLocaleString('it-IT')} cantine da fonti pubbliche: consorzi, associazioni, siti ufficiali. Qualcosa sarà impreciso. Chi meglio di te per sistemarlo?
    </p>
    <a href="#modulo" class="btn-primary mt-6">Rivendica la scheda</a>
    <Mascotte slot="aside" nota="Chi meglio di te?" class="w-36 sm:w-44" />
  </PosterHeader>

  <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
    <ol class="grid gap-4 sm:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-2xl border-2 border-inchiostro bg-carta p-6 shadow-[5px_5px_0_var(--color-inchiostro)]">
          <p class="manifesto text-7xl">{['I', 'II', 'III'][i]}</p>
          <h2 class="display mt-4 text-3xl">{s.t}</h2>
          <p class="mt-2 text-grafite">{s.d}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <section aria-labelledby="h-cosa">
        <h2 id="h-cosa" class="display text-4xl">Cosa puoi fare, <em>gratis</em></h2>
        <ul role="list" class="mt-5 border-t-2 border-inchiostro">
          {['Correggere indirizzo, contatti e posizione sulla mappa', 'Raccontare la cantina con parole tue', 'Pubblicare orari di apertura e giorni di visita', 'Proporre degustazioni e visite in vigna', 'Ricevere le richieste di visita direttamente'].map((t) => (
            <li class="flex gap-3 border-b-2 border-inchiostro py-3"><span class="text-rosso" aria-hidden="true">—</span>{t}</li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-grafite">In arrivo: la vendita diretta delle bottiglie e la prenotazione delle esperienze, con pagamenti gestiti dalla piattaforma e la spedizione a cura della cantina.</p>
      </section>

      <section id="modulo" aria-labelledby="h-modulo" class="scroll-mt-6 rounded-3xl border-2 border-inchiostro bg-carta p-6 shadow-[8px_8px_0_var(--color-inchiostro)] sm:p-8">
        <h2 id="h-modulo" class="display text-4xl">Rivendica <em>la scheda</em></h2>
        <FormNotice sent={sent} error={error} sentText="Grazie. Ti contatteremo per la verifica entro due giorni lavorativi." />
        {!sent && (
          <form method="post" action="/api/per-le-cantine" class="mt-6 space-y-4">
            <fieldset>
              <legend class="text-sm font-medium">Motivo</legend>
              <div class="mt-2 flex flex-wrap gap-4 text-sm">
                <label class="flex items-center gap-2"><input type="radio" name="motivo" value="claim" checked={motivo !== 'info' && motivo !== 'correzione'} class="accent-rosso" />Rivendicare una scheda</label>
                <label class="flex items-center gap-2"><input type="radio" name="motivo" value="correzione" checked={motivo === 'correzione'} class="accent-rosso" />Correggere o rimuovere dati e foto</label>
                <label class="flex items-center gap-2"><input type="radio" name="motivo" value="info" checked={motivo === 'info'} class="accent-rosso" />Solo informazioni</label>
              </div>
            </fieldset>
            <label class="block text-sm font-medium">Cantina
              <select name="cantina" class={field}>
                <option value="">— Scegli dal catalogo —</option>
                {wineries.map((w) => <option value={w.slug} selected={w.slug === preselected}>{displayName(w.name)}</option>)}
              </select>
            </label>
            <label class="block text-sm font-medium">…oppure scrivi il nome, se non la trovi<input name="cantina_nome" maxlength="160" class={field} /></label>
            <div class="grid gap-4 sm:grid-cols-2">
              <label class="block text-sm font-medium">Nome e cognome<input name="nome" required autocomplete="name" maxlength="200" class={field} /></label>
              <label class="block text-sm font-medium">Ruolo<input name="ruolo" placeholder="Titolare, enologa…" maxlength="80" class={field} /></label>
              <label class="block text-sm font-medium">Email<input name="email" type="email" required autocomplete="email" maxlength="200" class={field} /></label>
              <label class="block text-sm font-medium">Telefono<input name="telefono" type="tel" autocomplete="tel" maxlength="40" class={field} /></label>
            </div>
            <label class="block text-sm font-medium">Messaggio <span class="font-normal text-grafite">(facoltativo)</span><textarea name="messaggio" rows="3" maxlength="2000" class={`${field} h-auto py-2`}></textarea></label>
            <label class="hidden" aria-hidden="true">Non compilare<input name="sito_web" tabindex="-1" autocomplete="off" /></label>
            <label class="flex items-start gap-3 text-sm">
              <input type="checkbox" name="consenso" value="si" required class="mt-1 size-4 accent-rosso" />
              <span>Acconsento al trattamento dei miei dati per essere ricontattato, come descritto nell’<a href="/privacy" class="underline">informativa</a>.</span>
            </label>
            <button type="submit" class="btn-primary">Invia</button>
          </form>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
