---
// Card cantina — Design System "Editorial Gastronomy" (vedi ui/snippets/winery-card.html).
// Nessuna foto finché la cantina non la carica (Fase 2): card compatta, solo testo.
import type { WineryListItem } from '../lib/db';

interface Props {
  winery: WineryListItem;
}
const { winery: w } = Astro.props;
const denominations = w.denominations?.split('|') ?? [];
const services = w.services?.split('|') ?? [];
const meta = [w.province_name, w.territory_name].filter(Boolean);
const place = w.municipality ? `${w.municipality}${w.province_code ? ` (${w.province_code})` : ''}` : w.province_name;
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-md border border-subtle bg-primary transition-colors duration-200 hover:border-muted/60">
  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <p class="meta text-muted">{meta.join(' · ')}</p>
      {w.claim_status === 'claimed' && <span class="meta shrink-0 rounded-md border border-subtle px-2 py-1 text-[10px] text-wine">Verificata</span>}
    </div>
    <h3 class="mt-2 font-serif text-[1.65rem] font-medium leading-tight text-main">
      <a href={`/cantine/${w.slug}`} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{w.name}</a>
    </h3>
    {place && <p class="mt-1 text-sm text-muted">{place}</p>}

    {denominations.length > 0 && (
      <ul role="list" aria-label="Denominazioni" class="mt-4 flex flex-wrap gap-1.5">
        {denominations.slice(0, 3).map((d) => (
          <li class="meta rounded-md border border-subtle px-2 py-1 text-[10px] text-main">{d}</li>
        ))}
        {denominations.length > 3 && <li class="meta px-1 py-1 text-[10px] text-muted">+{denominations.length - 3}</li>}
      </ul>
    )}

    <div class="min-h-5 flex-1" aria-hidden="true"></div>
    <div class="flex items-center justify-between gap-3 border-t border-subtle pt-4 text-sm">
      <p class="text-muted">
        {w.rating_count > 0 ? `★ ${w.rating_avg.toFixed(1).replace('.', ',')} (${w.rating_count})` : w.wine_count > 0 ? `${w.wine_count} vini` : 'Scheda da completare'}
      </p>
      {services.length > 0 && <p class="text-right text-muted">{services[0]}</p>}
    </div>
  </div>
</article>
