---
// Voce di catalogo: numero, nome in corpo grande, luogo, denominazioni a macchina.
// Nessuna foto finché la cantina non la carica (Fase 2).
import type { WineryListItem } from '../lib/db';
import { catalogNo, displayName } from '../lib/palette';

interface Props {
  winery: WineryListItem;
  headingLevel?: 'h2' | 'h3';
}
const { winery: w, headingLevel: H = 'h3' } = Astro.props;
const denominations = w.denominations?.split('|') ?? [];
const services = w.services?.split('|') ?? [];
const place = w.municipality ? `${w.municipality}${w.province_code ? ` (${w.province_code})` : ''}` : w.province_name;
const facts = [
  w.rating_count > 0 ? `★ ${w.rating_avg.toFixed(1).replace('.', ',')} (${w.rating_count})` : null,
  w.wine_count > 0 ? `${w.wine_count} ${w.wine_count === 1 ? 'vino' : 'vini'}` : null,
  ...services,
].filter(Boolean);
---
<article class="group relative flex h-full flex-col border-t border-inchiostro pb-6 pt-3">
  <div class="flex items-baseline justify-between gap-3">
    <p class="meta text-grafite">{catalogNo(w.num)}{w.province_name && ` · ${w.province_name}`}</p>
    {w.claim_status === 'claimed' && <p class="meta text-rosso">Verificata</p>}
  </div>
  <H class="display mt-3 text-[1.85rem] sm:text-[2.1rem]">
    <a href={`/cantine/${w.slug}`} class="decoration-rosso after:absolute after:inset-0 after:content-[''] group-hover:underline focus-visible:outline-none">{displayName(w.name)}</a>
  </H>
  <p class="mt-1.5 text-grafite">
    {place}{w.territory_name && <>, <em class="font-serif text-[1.08em]">{w.territory_name}</em></>}
  </p>

  {denominations.length > 0 && (
    <p class="meta mt-4 leading-relaxed text-inchiostro">
      <span class="sr-only">Denominazioni: </span>{denominations.slice(0, 3).join(' / ')}{denominations.length > 3 && ` / +${denominations.length - 3}`}
    </p>
  )}

  <div class="min-h-4 flex-1" aria-hidden="true"></div>
  <p class="flex items-baseline justify-between gap-3 text-sm text-grafite">
    <span>{facts.length > 0 ? facts.join(' · ') : 'Scheda in attesa della cantina'}</span>
    <span aria-hidden="true" class="text-inchiostro transition-transform group-hover:translate-x-1">→</span>
  </p>
</article>
