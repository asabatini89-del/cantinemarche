---
// La home a tutto schermo: le Marche vere in 3D (vedi src/scripts/mappa-viva.ts).
// Sopra la mappa, a sinistra, il "manifesto" su un velo albicocca; a destra il pannello
// della cantina che entra a molla. Senza WebGL o senza JS resta la mappa SVG.
import MarcheMap from './MarcheMap.astro';
import type { MapCard, MapPoint } from '../lib/db';
import { PROVINCE_COVER } from '../lib/palette';

interface Props {
  cards: MapCard[];
  points: MapPoint[];
  provinces: { value: string; label: string; count: number }[];
  total: number;
}
const { cards, points, provinces, total } = Astro.props;
---
<section class="mappa-viva" data-mappa-viva aria-labelledby="mv-title" data-mv-state="init">
  <div class="mv-canvas" data-mv-canvas role="region" aria-label={`Mappa 3D delle Marche con ${cards.length} cantine: tocca un punto per aprirne la scheda`}></div>

  <div class="mv-veil grana" aria-hidden="true"></div>

  <div class="mv-intro">
    <p class="meta mv-rise" style="--r:0">Catalogo ragionato · {total} cantine</p>
    <h1 id="mv-title" class="mv-title">
      <span class="sr-only">Cantine delle Marche: mappa e catalogo delle cantine marchigiane</span>
      <span class="manifesto mv-line mv-big" aria-hidden="true" style="--r:1">Cantine</span>
      <span class="mv-line mv-delle" aria-hidden="true" style="--r:2">delle</span>
      <span class="manifesto spaziato mv-line" aria-hidden="true" style="--r:3">Marche</span>
    </h1>
    <p class="mv-rise mv-lede" style="--r:4">Le colline vere, viste dal satellite. Tocca una provincia per volarci sopra, poi un puntino: la cantina ti viene incontro.</p>

    <form method="get" action="/cantine" role="search" class="mv-rise mv-search" style="--r:5">
      <label for="home-q" class="sr-only">Cerca cantina, comune o vino</label>
      <input id="home-q" name="q" type="search" required placeholder="Cantina, borgo o vino…" enterkeyhint="search" />
      <button type="submit">Cerca</button>
    </form>

    <nav aria-labelledby="mv-prov" class="mv-rise mv-provs" style="--r:6">
      <h2 id="mv-prov" class="meta">Vola su una provincia</h2>
      <ul role="list">
        <li><a href="/cantine" data-mv-goto="all" aria-current="true" class="pillola">Tutte</a></li>
        {provinces.map((p) => (
          <li>
            <a href={`/cantine?provincia=${p.value}`} data-mv-goto={p.value} class="pillola">
              <span class={`mv-swatch ${PROVINCE_COVER[p.value]?.bg ?? ''}`} aria-hidden="true"></span>{p.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="mv-rise mv-meta" style="--r:7">
      <span class="meta" data-mv-count aria-live="polite">{cards.length} cantine sulla mappa</span>
      <a href="/cantine" data-mv-list class="mv-list">Tutte le cantine in elenco →</a>
    </p>
    <p class="mano mv-note" aria-hidden="true">Domani degustazione?<br />Tocca un puntino.</p>
  </div>

  <div class="mv-controls" role="group" aria-label="Comandi della mappa">
    <button type="button" data-mv-zoom-in aria-label="Avvicina">+</button>
    <button type="button" data-mv-zoom-out aria-label="Allontana">−</button>
    <button type="button" data-mv-tilt aria-pressed="true" aria-label="Vista inclinata o dall'alto">3D</button>
    <button type="button" data-mv-orbit aria-label="Fai ruotare la regione o fermala"><span aria-hidden="true">↻</span></button>
    <button type="button" data-mv-home aria-label="Tutte le Marche"><span aria-hidden="true">⌂</span></button>
  </div>

  <p class="mv-hint meta" data-mv-hint hidden>
    <span class="mv-hint-fine">Trascina per spostarti · Ctrl + rotellina per avvicinarti · tasto destro per ruotare</span>
    <span class="mv-hint-touch">Due dita per muovere, ruotare e avvicinarti</span>
  </p>

  <aside class="mv-panel" data-mv-panel aria-hidden="true" aria-labelledby="mv-panel-title">
    <button type="button" class="mv-close" data-mv-close aria-label="Chiudi la scheda e torna alla mappa">✕</button>
    <div class="mv-panel-body" data-mv-panel-body></div>
  </aside>

  <a href="#dopo-la-mappa" class="mv-scroll pillola">Il catalogo <span aria-hidden="true">↓</span></a>

  <div class="mv-fallback" data-mv-fallback hidden>
    <div class="mx-auto max-w-3xl px-4 pt-28">
      <MarcheMap points={points} explore label={`Mappa delle Marche con ${points.length} cantine`} />
    </div>
  </div>
  <noscript><style>[data-mv-fallback]{display:block!important}.mv-canvas,.mv-controls{display:none}</style></noscript>

  <script type="application/json" data-mv-cards set:html={JSON.stringify(cards).replace(/</g, '\\u003c')} />
</section>

<script>
  import { initMappaViva } from '../scripts/mappa-viva';
  for (const el of document.querySelectorAll<HTMLElement>('[data-mappa-viva]')) initMappaViva(el);
</script>

<style>
  .mappa-viva {
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: #d9c29a;
    isolation: isolate;
  }
  .mv-canvas { position: absolute; inset: 0; }
  .mv-fallback { position: absolute; inset: 0; overflow: auto; background: var(--color-pesca); z-index: 5; }

  /* Velo-poster: albicocca a sinistra che sfuma nel satellite */
  .mv-veil {
    position: absolute; inset: 0; pointer-events: none; z-index: 1;
    background-color: transparent;
    background-image:
      linear-gradient(90deg, rgb(252 203 143 / .97) 0%, rgb(252 203 143 / .92) 27%, rgb(252 203 143 / .5) 39%, rgb(252 203 143 / 0) 50%),
      linear-gradient(180deg, rgb(252 203 143 / .55) 0, rgb(252 203 143 / 0) 120px);
    transition: opacity .8s;
  }
  .mv-intro {
    position: absolute; z-index: 2; left: max(1.5rem, calc((100vw - 72rem) / 2 + 1.5rem)); top: 6.5rem;
    width: min(33rem, 38vw); display: flex; flex-direction: column; gap: 1.1rem;
  }
  .mv-title { display: flex; flex-direction: column; line-height: .82; }
  .mv-title .mv-big { font-size: clamp(3.4rem, 6.6vw, 7rem); }
  .mv-delle { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.6rem, 2.6vw, 2.6rem); color: var(--color-inchiostro); margin: .1em 0 .05em .2em; }
  .mv-title .spaziato { font-size: clamp(2rem, 4.4vw, 4.6rem); }
  .mv-lede { font-size: 1.05rem; line-height: 1.45; max-width: 26rem; }
  .mv-search { display: flex; border: 2px solid var(--color-inchiostro); border-radius: 999px; background: var(--color-carta); padding: .25rem; max-width: 26rem; box-shadow: 4px 4px 0 var(--color-inchiostro); }
  .mv-search input { flex: 1; min-width: 0; height: 2.5rem; border-radius: 999px; background: transparent; padding: 0 1rem; font-size: 1rem; }
  .mv-search input:focus { outline: none; }
  .mv-search button { height: 2.5rem; border-radius: 999px; background: var(--color-inchiostro); color: var(--color-carta); padding: 0 1.2rem; font-size: .875rem; font-weight: 500; transition: background .2s; }
  .mv-search button:hover { background: var(--color-rosso); }
  .mv-provs ul { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .6rem; }
  .mv-provs .pillola { height: 2.1rem; gap: .45rem; padding-block: 0; background: var(--color-carta); transition: transform .25s cubic-bezier(.3,1.6,.5,1), background .2s, color .2s; }
  .mv-provs .pillola:hover { background: var(--color-giallo); transform: translateY(-2px) rotate(-1deg); }
  .mv-provs .pillola[aria-current='true'] { background: var(--color-inchiostro); color: var(--color-carta); }
  .mv-swatch { width: .65rem; height: .65rem; border-radius: 999px; border: 1px solid var(--color-inchiostro); }
  .mv-meta { display: flex; flex-wrap: wrap; gap: .4rem 1rem; align-items: baseline; }
  .mv-list { font-size: .875rem; font-weight: 500; text-decoration: underline; text-decoration-color: var(--color-rosso); text-decoration-thickness: 2px; }
  .mv-note {
    margin-top: .2rem; width: max-content; transform: rotate(-4deg); font-size: 1.65rem;
    opacity: 0; animation: mv-fade .8s 5.2s ease forwards;
  }
  /* Cantina aperta: il manifesto si ritira, la mappa prende la scena */
  .mv-intro, .mv-veil { transition: opacity .6s cubic-bezier(.2,.9,.2,1), transform .6s cubic-bezier(.2,.9,.2,1); }
  .mappa-viva[data-mv-selected] .mv-intro { opacity: 0; transform: translateX(-40px); pointer-events: none; }
  .mappa-viva[data-mv-selected] .mv-veil { opacity: .15; }

  /* Ingresso del manifesto: le righe salgono da dietro una maschera */
  .mv-line { display: block; clip-path: inset(0 0 0 0); animation: mv-line 1.1s cubic-bezier(.2,.9,.2,1) both; animation-delay: calc(var(--r) * 140ms + 200ms); }
  .mv-rise { animation: mv-rise .9s cubic-bezier(.2,.9,.2,1) both; animation-delay: calc(var(--r) * 120ms + 500ms); }
  @keyframes mv-line { from { clip-path: inset(100% 0 0 0); transform: translateY(.35em); } to { clip-path: inset(-10% 0 -10% 0); transform: none; } }
  @keyframes mv-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes mv-fade { to { opacity: 1; } }

  .mv-controls {
    position: absolute; z-index: 3; right: 1.25rem; bottom: 5.5rem; display: flex; flex-direction: column; gap: .4rem;
  }
  /* Con la scheda aperta, comandi e crediti scivolano accanto al pannello invece di finirci sotto */
  .mv-controls, .mappa-viva :global(.maplibregl-ctrl-bottom-right) { transition: transform .75s cubic-bezier(.2,1.15,.3,1); }
  @media (min-width: 768px) {
    .mappa-viva[data-mv-selected] .mv-controls,
    .mappa-viva[data-mv-selected] :global(.maplibregl-ctrl-bottom-right) { transform: translateX(calc(-1 * min(27rem, 36vw) - 1.25rem)); }
  }
  .mv-controls button {
    width: 2.6rem; height: 2.6rem; border-radius: 999px; border: 2px solid var(--color-inchiostro); background: var(--color-carta);
    font-family: var(--font-mono); font-size: .85rem; box-shadow: 3px 3px 0 var(--color-inchiostro);
    transition: transform .2s cubic-bezier(.3,1.6,.5,1), background .2s;
  }
  .mv-controls button:hover { background: var(--color-giallo); transform: translate(-1px, -1px); }
  .mv-controls button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--color-inchiostro); }
  .mv-controls [aria-pressed='false'] { background: var(--color-inchiostro); color: var(--color-carta); }
  .mappa-viva[data-mv-orbit] [data-mv-orbit] span { display: inline-block; animation: mv-spin 2.4s linear infinite; }
  @keyframes mv-spin { to { transform: rotate(360deg); } }

  .mv-hint {
    position: absolute; z-index: 3; left: 50%; top: 1.5rem; translate: -50% 0; margin-top: 4.5rem;
    background: rgb(20 18 16 / .78); color: var(--color-carta); padding: .45rem .9rem; border-radius: 999px; animation: mv-rise .6s both;
  }
  .mv-hint-touch { display: none; }
  @media (pointer: coarse) { .mv-hint-fine { display: none; } .mv-hint-touch { display: inline; } }
  .mv-scroll {
    position: absolute; z-index: 3; left: 50%; bottom: 1.4rem; transform: translateX(-50%); background: var(--color-carta);
    height: 2.2rem; box-shadow: 3px 3px 0 var(--color-inchiostro); animation: mv-bob 2.4s ease-in-out infinite 3s;
  }
  .mv-scroll { transition: opacity .4s; }
  .mappa-viva[data-mv-selected] .mv-scroll { opacity: 0; pointer-events: none; }
  @keyframes mv-bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 6px; } }

  /* Pannello della cantina: entra a molla da destra (desktop) o dal basso (mobile) */
  .mv-panel {
    position: absolute; z-index: 4; top: 5.75rem; right: 1.25rem; bottom: 1.25rem; width: min(27rem, 36vw);
    background: var(--color-carta); border: 2px solid var(--color-inchiostro); border-radius: 1.5rem;
    box-shadow: 8px 8px 0 var(--color-inchiostro); overflow: hidden;
    transform: translateX(calc(100% + 3rem)) rotate(3deg); visibility: hidden;
    transition: transform .75s cubic-bezier(.2,1.25,.3,1), visibility 0s .75s;
  }
  .mv-panel.is-open { transform: none; visibility: visible; transition: transform .75s cubic-bezier(.2,1.25,.3,1), visibility 0s; }
  .mv-panel-body { height: 100%; overflow-y: auto; overscroll-behavior: contain; padding: 1.4rem 1.4rem 1.6rem; display: flex; flex-direction: column; gap: .85rem; }
  .mv-close {
    position: absolute; z-index: 2; right: .8rem; top: .8rem; width: 2.25rem; height: 2.25rem; border-radius: 999px;
    border: 2px solid var(--color-inchiostro); background: var(--color-carta); transition: transform .3s cubic-bezier(.3,1.6,.5,1);
  }
  .mv-close:hover { transform: rotate(90deg); background: var(--color-giallo); }
  .mv-panel :global(.mv-panel-cover) { margin: -1.4rem -1.4rem .2rem; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 2px solid var(--color-inchiostro); }
  .mv-panel :global(.mv-panel-cover img) { width: 100%; height: 100%; object-fit: cover; animation: mv-kenburns 9s ease-out both; }
  @keyframes mv-kenburns { from { transform: scale(1.12); } to { transform: scale(1); } }
  .mv-panel :global(h2) { font-size: clamp(2rem, 3vw, 2.6rem); padding-right: 2.5rem; outline: none; }
  .mv-panel :global(.mv-stats) { display: grid; grid-template-columns: 1fr 1fr; border-block: 2px solid var(--color-inchiostro); }
  .mv-panel :global(.mv-stats div) { padding: .5rem 0; }
  .mv-panel :global(.mv-stats div + div) { border-left: 2px solid var(--color-inchiostro); padding-left: .9rem; }
  .mv-panel :global(.mv-stats dd) { font-size: 2.6rem; }
  .mv-panel :global(.mv-panel-wines li) { padding: .4rem 0; border-bottom: 1px solid rgb(20 18 16 / .18); }
  .mv-panel :global(.mv-ticket) {
    display: flex; flex-direction: column; gap: .25rem; border: 2px solid var(--color-inchiostro); border-radius: 1rem; padding: .8rem 1rem;
    background: var(--color-giallo); box-shadow: 4px 4px 0 var(--color-inchiostro); transition: transform .25s cubic-bezier(.3,1.6,.5,1);
  }
  .mv-panel :global(.mv-ticket:hover) { transform: translate(-2px, -2px) rotate(-.6deg); }
  .mv-panel :global(.mv-ticket .display) { font-size: 1.35rem; }
  .mv-panel :global(.mv-actions) { display: flex; flex-wrap: wrap; gap: .5rem; }
  .mv-panel :global(.mv-hop) { display: flex; flex-wrap: wrap; gap: .5rem; padding-top: .4rem; border-top: 1px dashed rgb(20 18 16 / .3); }
  .mv-panel :global(.mv-hop .pillola) { height: 2.1rem; padding-block: 0; background: var(--color-carta); text-align: left; }
  .mv-panel :global(.mv-hop .pillola:hover:not(:disabled)) { background: var(--color-giallo); }
  .mv-panel :global(.mv-hop .pillola:disabled) { opacity: .35; }
  .mv-panel.is-open :global(.mv-stagger) { animation: mv-rise .6s cubic-bezier(.2,.9,.2,1) both; }
  .mv-panel.is-open :global(.mv-stagger:nth-child(2)) { animation-delay: .12s; }
  .mv-panel.is-open :global(.mv-stagger:nth-child(3)) { animation-delay: .18s; }
  .mv-panel.is-open :global(.mv-stagger:nth-child(4)) { animation-delay: .24s; }
  .mv-panel.is-open :global(.mv-stagger:nth-child(5)) { animation-delay: .3s; }
  .mv-panel.is-open :global(.mv-stagger:nth-child(6)) { animation-delay: .36s; }
  .mv-panel.is-open :global(.mv-stagger:nth-child(n+7)) { animation-delay: .42s; }

  /* Segnaposto e grappoli */
  .mappa-viva :global(.mv-pin), .mappa-viva :global(.mv-cluster) { cursor: pointer; background: none; border: 0; padding: 0; }
  .mappa-viva :global(.mv-in) { display: grid; place-items: center; position: relative; animation: mv-pop .6s cubic-bezier(.3,1.7,.5,1) both; animation-delay: var(--d, 0ms); transition: transform .3s cubic-bezier(.3,1.6,.5,1), opacity .3s; }
  .mappa-viva :global(.is-leaving .mv-in) { animation: mv-out .2s ease-in forwards; }
  @keyframes mv-pop { from { transform: scale(0) translateY(-18px); opacity: 0; } 60% { opacity: 1; } to { transform: none; opacity: 1; } }
  @keyframes mv-out { to { transform: scale(0); opacity: 0; } }
  .mappa-viva :global(.mv-pin) { width: 26px; height: 26px; }
  .mappa-viva :global(.mv-pin-dot) {
    width: 14px; height: 14px; border-radius: 999px; background: var(--pc, #fbf4e8); border: 2.5px solid var(--color-inchiostro);
    box-shadow: 0 2px 0 rgb(20 18 16 / .55), 0 0 0 2px rgb(251 244 232 / .9); transition: background .2s, transform .3s cubic-bezier(.3,1.6,.5,1);
  }
  .mappa-viva :global(.mv-pin[data-exp] .mv-pin-dot)::after { content: ''; position: absolute; width: 6px; height: 6px; border-radius: 999px; background: var(--color-rosso); top: 1px; right: 1px; }
  .mappa-viva :global(.mv-pin-ring) { position: absolute; width: 14px; height: 14px; border-radius: 999px; border: 2px solid var(--color-rosso); opacity: 0; }
  .mappa-viva :global(.mv-pin-label) {
    position: absolute; left: 50%; bottom: calc(100% + 6px); translate: -50% 6px; opacity: 0; pointer-events: none; white-space: nowrap;
    background: var(--color-carta); border: 2px solid var(--color-inchiostro); border-radius: .75rem; padding: .25rem .6rem;
    box-shadow: 3px 3px 0 var(--color-inchiostro); display: flex; flex-direction: column; align-items: flex-start; line-height: 1.15;
    transition: opacity .2s, translate .3s cubic-bezier(.3,1.6,.5,1);
  }
  .mappa-viva :global(.mv-pin-label b) { font-family: var(--font-serif); font-weight: 600; font-size: 1rem; }
  .mappa-viva :global(.mv-pin-label small) { font-family: var(--font-mono); font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; }
  .mappa-viva :global(.mv-pin:hover), .mappa-viva :global(.mv-pin:focus-visible) { z-index: 5; }
  .mappa-viva :global(.mv-pin:hover .mv-pin-dot), .mappa-viva :global(.mv-pin:focus-visible .mv-pin-dot) { transform: scale(1.45); background: var(--color-rosso); }
  .mappa-viva :global(.mv-pin:hover .mv-pin-label), .mappa-viva :global(.mv-pin:focus-visible .mv-pin-label) { opacity: 1; translate: -50% 0; }
  .mappa-viva :global(.mv-pin.is-active) { z-index: 6; }
  .mappa-viva :global(.mv-pin.is-active .mv-pin-dot) { background: var(--color-rosso); transform: scale(1.6); }
  .mappa-viva :global(.mv-pin.is-active .mv-pin-ring) { animation: mv-ripple 1.8s cubic-bezier(.2,.6,.3,1) infinite; }
  .mappa-viva :global(.mv-pin.is-active .mv-pin-ring + .mv-pin-ring) { animation-delay: .9s; }
  .mappa-viva :global(.mv-pin.is-active .mv-pin-label) { opacity: 1; translate: -50% -6px; }
  @keyframes mv-ripple { from { transform: scale(1); opacity: .9; } to { transform: scale(4.2); opacity: 0; } }
  .mappa-viva :global(.mv-pin.is-dim .mv-in) { opacity: .25; transform: scale(.75); }
  .mappa-viva[data-mv-selected] :global(.mv-pin:not(.is-active) .mv-in) { opacity: .55; }
  .mappa-viva :global(.mv-cluster .mv-in) {
    width: calc(var(--s) * 1px); height: calc(var(--s) * 1px); border-radius: 999px; background: rgb(251 244 232 / .92); color: var(--color-inchiostro);
    border: 2px solid var(--color-inchiostro); box-shadow: 2px 3px 0 rgb(20 18 16 / .55), 0 0 0 4px rgb(251 244 232 / .3);
    font-family: var(--font-serif); font-weight: 600; font-size: calc(var(--s) * .42px);
  }
  .mappa-viva :global(.mv-cluster:hover .mv-in) { transform: scale(1.14); background: var(--color-giallo); }

  .mappa-viva :global(.maplibregl-ctrl-attrib) { font-family: var(--font-mono); font-size: 10px; background: rgb(251 244 232 / .85); }
  .mappa-viva :global(.maplibregl-cooperative-gesture-screen) { font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .06em; font-size: .8rem; background: rgb(20 18 16 / .45); }
  .mappa-viva[data-mv-state='loading'] .mv-canvas, .mappa-viva[data-mv-state='init'] .mv-canvas { opacity: 0; }
  .mv-canvas { transition: opacity 1.2s ease; }

  @media (max-width: 767px) {
    .mappa-viva { height: 100svh; min-height: 560px; }
    .mv-veil {
      background-image:
        linear-gradient(180deg, rgb(252 203 143 / .96) 0, rgb(252 203 143 / .88) 34%, rgb(252 203 143 / 0) 52%),
        linear-gradient(0deg, rgb(252 203 143 / .85) 0, rgb(252 203 143 / 0) 22%);
    }
    .mv-intro { left: 1rem; right: 1rem; top: 4.75rem; width: auto; gap: .6rem; }
    .mv-title { flex-direction: row; flex-wrap: wrap; align-items: baseline; gap: .15rem .4rem; line-height: .92; }
    .mv-title .mv-big { font-size: clamp(2.6rem, 13vw, 3.6rem); }
    .mv-title .spaziato { font-size: clamp(1.9rem, 9vw, 2.6rem); }
    .mv-delle { font-size: 1.3rem; margin: 0; }
    .mv-lede, .mv-search, .mv-note { display: none; }
    .mv-provs h2 { display: none; }
    .mv-provs ul { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 0 -1rem; padding: 0 1rem .35rem; }
    .mv-provs li { flex: none; }
    .mv-provs .pillola { white-space: nowrap; }
    .mv-hint { top: auto; bottom: 4.25rem; margin: 0; white-space: nowrap; }
    .mv-meta .mv-list { display: none; }
    .mv-controls { right: .75rem; bottom: 6.5rem; }
    .mv-controls button { width: 2.4rem; height: 2.4rem; }
    .mv-scroll { bottom: 1rem; }
    .mv-panel {
      top: auto; left: 0; right: 0; bottom: 0; width: auto; max-height: 64svh; border-radius: 1.5rem 1.5rem 0 0; border-bottom: 0;
      box-shadow: 0 -6px 0 var(--color-inchiostro); transform: translateY(105%);
