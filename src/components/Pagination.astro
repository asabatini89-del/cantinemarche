---
interface Props {
  page: number;
  pages: number;
  href: (page: number) => string;
}
const { page, pages, href } = Astro.props;
// Pagine visibili: prima, ultima, attuale ± 1, con ellissi.
const shown = [...new Set([1, page - 1, page, page + 1, pages])].filter((n) => n >= 1 && n <= pages).sort((a, b) => a - b);
---
{pages > 1 && (
  <nav aria-label="Pagine del catalogo" class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t-2 border-inchiostro pt-5">
    {page > 1 ? <a rel="prev" href={href(page - 1)} class="btn h-10">← Precedenti</a> : <span class="hidden sm:block"></span>}
    <ol class="meta order-last flex w-full items-center justify-center gap-1 sm:order-none sm:w-auto">
      {shown.map((n, i) => (
        <>
          {i > 0 && n - shown[i - 1] > 1 && <li aria-hidden="true" class="px-1 text-grafite">…</li>}
          <li>
            {n === page
              ? <span aria-current="page" class="inline-flex size-9 items-center justify-center rounded-full bg-rosso text-carta">{n}</span>
              : <a href={href(n)} class="inline-flex size-9 items-center justify-center rounded-full border-[1.5px] border-transparent hover:border-inchiostro hover:bg-giallo">{n}</a>}
          </li>
        </>
      ))}
    </ol>
    {page < pages ? <a rel="next" href={href(page + 1)} class="btn h-10">Successive →</a> : <span class="hidden sm:block"></span>}
  </nav>
)}
