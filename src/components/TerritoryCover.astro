---
// Copertina da collana anni Settanta (omaggio alle copertine Picador di Tom Wolfe):
// fascia crema con la collana, pannello pieno con il numero, titolo tra filetti, pillola dell'editore.
import type { Territory } from '../lib/db';
import { coverFor } from '../lib/palette';

interface Props {
  territory: Territory;
  index: number;
  size?: 'sm' | 'lg';
}
const { territory: t, index, size = 'sm' } = Astro.props;
const n = String(index + 1).padStart(2, '0');
const wines = (t.denominations ?? '').split('|').filter(Boolean).map((d) => d.split(':')[1].replace(/ (DOCG|DOC|IGT)$/, ''));
const lg = size === 'lg';
const nota = [...wines].sort((a, b) => a.length - b.length)[0];
---
<a href={`/territori/${t.slug}`} class="group flex aspect-[2/3] flex-col overflow-hidden rounded-sm border-2 border-inchiostro bg-carta transition-transform duration-300 hover:-translate-y-1 hover:shadow-[6px_6px_0_var(--color-inchiostro)]">
  <span class="flex items-center justify-between px-3 pb-2 pt-3">
    <span class={`display ${lg ? 'text-2xl' : 'text-lg sm:text-xl'}`}>I territori</span>
    <span class="meta">N. {n}</span>
  </span>
  <span class={`relative flex flex-1 items-center justify-center border-y-2 border-inchiostro ${coverFor(t.id)}`}>
    <span class={`manifesto text-inchiostro/90 transition-transform duration-500 group-hover:scale-110 ${lg ? 'text-[9rem]' : 'text-[clamp(4rem,11vw,6.5rem)]'}`} aria-hidden="true">{n}</span>
    {nota && <span class={`mano absolute bottom-1.5 right-2 max-w-[85%] -rotate-6 truncate text-right ${lg ? 'text-2xl' : 'text-base sm:text-lg'}`}>{nota}</span>}
  </span>
  <span class={`display block border-b border-inchiostro px-3 py-2 leading-[1.05] ${lg ? 'text-4xl' : 'text-xl sm:text-[1.6rem]'}`}>{t.name}</span>
  <span class="flex items-center justify-between px-3 py-2">
    <span class="meta">{t.winery_count} cantine</span>
    <span class="pillola px-2 text-[9px] group-hover:bg-giallo">Leggi →</span>
  </span>
</a>
