---
// Caratteri self-hosted (niente Google Fonts: più veloce e nessun dato a terzi).
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/instrument-sans/index.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource-variable/caveat/index.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  /** Intestazione flottante sopra un contenuto a tutto schermo (la mappa della home). */
  overlayHeader?: boolean;
}
const {
  title,
  description = 'Catalogo ragionato delle cantine marchigiane: produttori, territori, denominazioni. Per chi beve con un libro in tasca.',
  canonical,
  noindex = false,
  overlayHeader = false,
} = Astro.props;
const fullTitle = title === 'Cantine delle Marche' ? `${title} — Catalogo ragionato` : `${title} — Cantine delle Marche`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'La mappa', active: path === '/' },
  { href: '/cantine', label: 'Le cantine', active: path.startsWith('/cantine') },
  { href: '/territori', label: 'I territori', active: path.startsWith('/territori') },
  { href: '/denominazioni', label: 'Le denominazioni', active: path.startsWith('/denominazioni') },
];
---
<!doctype html>
<html lang="it" data-base="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta name="theme-color" content="#fccb8f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenuto" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-inchiostro focus:px-4 focus:py-2 focus:text-carta">Vai al contenuto</a>

    <header data-site-header class:list={['site-header z-40', overlayHeader ? 'is-overlay' : 'border-b-2 border-inchiostro bg-carta']}>
      <div class="site-header-bar mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-3 sm:px-6">
        <a href="/" class="group flex items-center gap-3 leading-none" aria-label="Cantine delle Marche, alla home">
          <span class="manifesto whitespace-nowrap text-[1.12rem] tracking-[0.05em] sm:text-[1.75rem]">Cantine <span class="italic normal-case tracking-normal">delle</span> Marche</span>
          <span class="pillola hidden text-[10px] lg:inline-flex">Catalogo · 2026</span>
        </a>

        <nav aria-label="Principale" class="hidden md:block">
          <ul role="list" class="flex items-center gap-5 text-sm">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={n.active ? 'page' : undefined} class="decoration-rosso decoration-2 hover:underline aria-[current=page]:underline">{n.label}</a></li>
            ))}
            <li><a href="/per-le-cantine" class="btn-primary h-9 px-4" aria-current={path === '/per-le-cantine' ? 'page' : undefined}>Per le cantine</a></li>
          </ul>
        </nav>

        <details class="group relative md:hidden">
          <summary class="pillola h-9 cursor-pointer list-none bg-carta [&::-webkit-details-marker]:hidden">
            <span class="group-open:hidden">Indice</span><span class="hidden group-open:inline">Chiudi</span>
          </summary>
          <nav aria-label="Principale" class="absolute right-0 top-12 z-40 w-72 overflow-hidden rounded-2xl border-2 border-inchiostro bg-carta shadow-[5px_5px_0_var(--color-inchiostro)]">
            <ol class="divide-y divide-inchiostro/20">
              {[...nav, { href: '/per-le-cantine', label: 'Per le cantine', active: path === '/per-le-cantine' }].map((n, i) => (
                <li>
                  <a href={n.href} aria-current={n.active ? 'page' : undefined} class="flex items-baseline gap-3 px-4 py-3 hover:bg-giallo aria-[current=page]:text-rosso">
                    <span class="meta text-grafite">{String(i + 1).padStart(2, '0')}</span>
                    <span class="display text-2xl">{n.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      </div>
    </header>

    <script is:inline>
      // Rivelazione allo scroll per gli elementi con data-reveal.
      document.documentElement.setAttribute('data-js', '');
      addEventListener('DOMContentLoaded', () => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('is-in')); return; }
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        els.forEach((e) => io.observe(e));
      });
      // L'intestazione si ritira scorrendo verso il basso e torna appena si risale.
      (() => {
        const h = document.querySelector('[data-site-header]');
        if (!h) return;
        let last = scrollY;
        addEventListener('scroll', () => {
          const y = scrollY;
          if (Math.abs(y - last) < 6) return;
          h.toggleAttribute('data-hidden', y > last && y > 140 && !h.querySelector('details[open]'));
          h.toggleAttribute('data-scrolled', y > 20);
          last = y;
        }, { passive: true });
      })();
    </script>

    <main id="contenuto" class="flex-1">
      <slot />
    </main>

    <footer class="grana mt-20 border-t-2 border-inchiostro bg-pesca">
      <div class="mx-auto max-w-6xl px-4 pt-12 sm:px-6">
        <p class="manifesto spaziato text-center text-[clamp(3rem,13vw,10rem)]" aria-hidden="true">Salute</p>
      </div>
      <div class="mx-auto grid max-w-6xl gap-8 px-4 pb-10 pt-10 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
        <div>
          <p class="display text-3xl">Il vino, <em>prima di tutto</em>, è un paesaggio.</p>
          <p class="mt-3 max-w-md text-sm">Un catalogo indipendente delle cantine delle Marche, compilato da fonti pubbliche e aggiornato con i produttori.</p>
          <p class="mano mt-4 -rotate-2 text-2xl">…e domani brunch in vigna?</p>
        </div>
        <nav aria-label="Secondaria">
          <p class="meta">Indice</p>
          <ul role="list" class="mt-3 space-y-1.5 text-sm">
            {nav.map((n) => <li><a href={n.href} class="hover:underline">{n.label}</a></li>)}
            <li><a href="/per-le-cantine" class="hover:underline">Per le cantine</a></li>
          </ul>
        </nav>
        <div>
          <p class="meta">Colophon</p>
          <p class="mt-3 text-sm">
            Composto in Bodoni Moda, Instrument Sans, IBM Plex Mono e Caveat. Confini ISTAT (CC BY 4.0), coordinate in parte © OpenStreetMap (ODbL).
          </p>
          <p class="mt-2 text-sm"><a href="/privacy" class="underline">Privacy, fonti e licenze</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
